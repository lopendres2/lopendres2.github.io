# Скопируйте этот файл в .env и заполните значения.
# Токен выдаёт @BotFather в Telegram.
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ID администраторов через запятую (узнать свой: команда /myid в боте).
ADMIN_IDS=123456789

# Адрес Mini App. Telegram требует https.
WEBAPP_URL=https://lopendres2.github.io/

# Необязательно: путь к каталогу. По умолчанию data/data.json рядом с bot.py.
# DATA_FILE=data/data.json
